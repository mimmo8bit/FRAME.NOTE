# Versione di FFmpeg inclusa come sidecar. Cambiare questi valori (e il suffisso
# della release) fa ricompilare e ripubblicare i binari alla build successiva.
FFMPEG_VERSION=8.1.2
FFMPEG_SERIES=8.1
# SHA256 di ffmpeg-8.1.2.tar.xz (sorgenti ufficiali, firma GPG verificata il 2026-10-13
# con la chiave di rilascio FFmpeg FCF986EA15E6E293A5644F10B4322F04D67658D8).
FFMPEG_SHA256=464beb5e7bf0c311e68b45ae2f04e9cc2af88851abb4082231742a74d97b524c
FFMPEG_RELEASE_TAG=ffmpeg-8.1.2-lgpl-1

# Hash dei sidecar pubblicati in FFMPEG_RELEASE_TAG, fissati nel repository:
# fetch-ffmpeg.sh rifiuta un binario diverso anche se la release venisse
# modificata. Quando cambia FFMPEG_RELEASE_TAG vanno aggiornati (li stampa il
# primo Build che fallisce, presi dallo SHA256SUMS.txt della nuova release).
FFMPEG_PINNED_TAG=ffmpeg-8.1.2-lgpl-1
FFMPEG_SIDECAR_SHA256_aarch64_apple_darwin=951c20202bdf51165b9140e8f8126b537d0970cadbf06055d4ec031d6c51c8dd
FFMPEG_SIDECAR_SHA256_x86_64_pc_windows_msvc=aa71e370411076efb495e14909106383b166db04bb091f0b1dd89c4a23f349d7
